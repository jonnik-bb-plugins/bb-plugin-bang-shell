{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "command-text.ts",
    "test"
  ]
}
